{
  "enabled": true,
  "jvmId": "order-srv-node1",
  "probePort": 9876,
  "probeEnabled": true,
  "logDirectory": "./agent-logs",
  "logFileName": "trace.log",
  "maxFileSizeBytes": 20971520,
  "maxBackupFiles": 5,
  "_comment_basePackages": "Target packages to instrument. E.g. ['com.company.*']. If left empty ([] or ['*']), all non-excluded packages are traced.",
  "basePackages": [
    "com.mderyol.*"
  ],
  "_comment_excludePackages": "Third-party libraries and framework packages to exclude from instrumentation (wildcards .* supported).",
  "excludePackages": [
    "com.mderyol.javaagent",
    "java.*",
    "javax.*",
    "jdk.*",
    "sun.*",
    "oracle.*",
    "org.springframework.*",
    "org.apache.*",
    "org.hibernate.*",
    "com.fasterxml.jackson.*",
    "net.bytebuddy.*",
    "io.netty.*",
    "com.mysql.*",
    "org.postgresql.*"
  ],
  "excludeMethodKeywords": [
    "toString",
    "hashCode",
    "equals",
    "clone",
    "<init>",
    "<clinit>"
  ],
  "queueCapacity": 20000,
  "batchSize": 500,
  "flushIntervalMs": 1000,
  "maxCallDepth": 64,
  "_comment_metrics": "Periodic Host Machine & JVM resource metrics reporting (CPU, Memory, Threads, GC, Disk). Logs to rotating NDJSON file.",
  "metricsEnabled": true,
  "metricsIntervalSeconds": 60,
  "metricsFileName": "metrics.log",
  "metricsMaxFileSizeBytes": 10485760,
  "metricsMaxBackupFiles": 3
}