{
  "enabled": true,
  "probePort": 9876,
  "probeEnabled": true,
  "logDirectory": "./agent-logs",
  "logFileName": "trace.log",
  "maxFileSizeBytes": 20971520,
  "maxBackupFiles": 5,
  "basePackages": [
    "com.mderyol.*"
  ],
  "excludePackages": [
    "com.mderyol.javaagent",
    "java.*",
    "javax.*",
    "jdk.*",
    "sun.*",
    "oracle.*",
    "org.springframework.*",
    "org.apache.*",
    "org.hibernate.*",
    "com.fasterxml.jackson.*",
    "net.bytebuddy.*",
    "io.netty.*",
    "com.mysql.*",
    "org.postgresql.*"
  ],
  "excludeMethodKeywords": [
    "toString",
    "hashCode",
    "equals",
    "clone",
    "<init>",
    "<clinit>"
  ],
  "queueCapacity": 20000,
  "batchSize": 500,
  "flushIntervalMs": 1000,
  "maxCallDepth": 64,
  "maxPayloadLength": 2048,
  "metricsEnabled": true,
  "metricsIntervalSeconds": 60,
  "metricsFileName": "metrics.log",
  "metricsMaxFileSizeBytes": 10485760,
  "metricsMaxBackupFiles": 3
}